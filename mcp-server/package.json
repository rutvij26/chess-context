{
  "name": "mcp-chess",
  "version": "0.7.0",
  "description": "ChessContext MCP — semantic chess intelligence for Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-chess": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/store/schema.sql', 'dist/store/schema.sql')\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "chess.js": "^1.3.0",
    "hono": "^4.13.13",
    "lru-cache": "^11.5.3",
    "postgres": "^3.4.9",
    "stockfish": "^18.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "chess",
    "mcp",
    "claude",
    "stockfish",
    "model-context-protocol"
  ],
  "license": "MIT",
  "overrides": {
    "@hono/node-server": "^2.1.5",
    "fast-uri": "^4.2.2",
    "ip-address": "^10.7.4",
    "express-rate-limit": "^8.7.1",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "body-parser": "^2.3.0"
  }
}
